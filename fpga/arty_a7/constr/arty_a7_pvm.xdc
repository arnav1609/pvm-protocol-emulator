# Digilent Arty A7-100 Rev D/E master XDC, cross-checked against AMD CSG324.
# https://github.com/Digilent/digilent-xdc/blob/master/Arty-A7-100-Master.xdc
# JA SPI pins are observation outputs in this USB bridge build.
set_property -dict { PACKAGE_PIN E3 IOSTANDARD LVCMOS33 } [get_ports {clk100}]
set_property -dict { PACKAGE_PIN C2 IOSTANDARD LVCMOS33 } [get_ports {board_reset_n}]
set_property -dict { PACKAGE_PIN A9 IOSTANDARD LVCMOS33 } [get_ports {usb_uart_rx}]
set_property -dict { PACKAGE_PIN D10 IOSTANDARD LVCMOS33 } [get_ports {usb_uart_tx}]
set_property -dict { PACKAGE_PIN H5 IOSTANDARD LVCMOS33 } [get_ports {led[0]}]
set_property -dict { PACKAGE_PIN J5 IOSTANDARD LVCMOS33 } [get_ports {led[1]}]
set_property -dict { PACKAGE_PIN T9 IOSTANDARD LVCMOS33 } [get_ports {led[2]}]
set_property -dict { PACKAGE_PIN T10 IOSTANDARD LVCMOS33 } [get_ports {led[3]}]
set_property -dict { PACKAGE_PIN G13 IOSTANDARD LVCMOS33 } [get_ports {host_spi_probe[0]}]
set_property -dict { PACKAGE_PIN B11 IOSTANDARD LVCMOS33 } [get_ports {host_spi_probe[1]}]
set_property -dict { PACKAGE_PIN A11 IOSTANDARD LVCMOS33 } [get_ports {host_spi_probe[2]}]
set_property -dict { PACKAGE_PIN D12 IOSTANDARD LVCMOS33 } [get_ports {host_spi_probe[3]}]
set_property -dict { PACKAGE_PIN E15 IOSTANDARD LVCMOS33 } [get_ports {protocol_out[0]}]
set_property -dict { PACKAGE_PIN E16 IOSTANDARD LVCMOS33 } [get_ports {protocol_out[1]}]
set_property -dict { PACKAGE_PIN D15 IOSTANDARD LVCMOS33 } [get_ports {protocol_out[2]}]
set_property -dict { PACKAGE_PIN C15 IOSTANDARD LVCMOS33 } [get_ports {protocol_out[3]}]
set_property -dict { PACKAGE_PIN J17 IOSTANDARD LVCMOS33 } [get_ports {protocol_out[4]}]
set_property -dict { PACKAGE_PIN J18 IOSTANDARD LVCMOS33 } [get_ports {protocol_out[5]}]
set_property -dict { PACKAGE_PIN K15 IOSTANDARD LVCMOS33 } [get_ports {protocol_out[6]}]
# J3 chipKIT I2C buses and the FPGA pins feeding 2.2 kOhm R100/R101.
set_property -dict { PACKAGE_PIN M18 IOSTANDARD LVCMOS33 } [get_ports {protocol_io[0]}]
set_property -dict { PACKAGE_PIN L18 IOSTANDARD LVCMOS33 } [get_ports {protocol_io[1]}]
set_property -dict { PACKAGE_PIN A13 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW } [get_ports {i2c_pullup[0]}]
set_property -dict { PACKAGE_PIN A14 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW } [get_ports {i2c_pullup[1]}]
set_property -dict { PACKAGE_PIN V10 IOSTANDARD LVCMOS33 } [get_ports {protocol_io[2]}]
set_property -dict { PACKAGE_PIN V11 IOSTANDARD LVCMOS33 } [get_ports {protocol_io[3]}]
set_property -dict { PACKAGE_PIN U14 IOSTANDARD LVCMOS33 } [get_ports {protocol_io[4]}]
set_property -dict { PACKAGE_PIN V14 IOSTANDARD LVCMOS33 } [get_ports {protocol_io[5]}]
set_property -dict { PACKAGE_PIN T13 IOSTANDARD LVCMOS33 } [get_ports {protocol_io[6]}]
set_property -dict { PACKAGE_PIN U13 IOSTANDARD LVCMOS33 } [get_ports {protocol_io[7]}]
set_property -dict { PACKAGE_PIN D4 IOSTANDARD LVCMOS33 } [get_ports {protocol_in[0]}]
set_property -dict { PACKAGE_PIN D3 IOSTANDARD LVCMOS33 } [get_ports {protocol_in[1]}]
set_property -dict { PACKAGE_PIN F4 IOSTANDARD LVCMOS33 } [get_ports {protocol_in[2]}]
set_property -dict { PACKAGE_PIN F3 IOSTANDARD LVCMOS33 } [get_ports {protocol_in[3]}]
set_property -dict { PACKAGE_PIN E2 IOSTANDARD LVCMOS33 } [get_ports {protocol_in[4]}]
set_property -dict { PACKAGE_PIN A8 IOSTANDARD LVCMOS33 } [get_ports {fixture_switch}]
create_clock -name board_clk100 -period 10.000 [get_ports {clk100}]
# Vivado derives the 50 MHz generated clock at MMCME2 CLKOUT0.
# The external UART and protocol stimulus are asynchronous to the core.
# Cut pad-to-sampler paths only. The synchronous paths continue to be timed.
set_false_path -from [get_ports {usb_uart_rx fixture_switch protocol_in[*] protocol_io[*]}]
set_false_path -from [get_ports {board_reset_n}]
set_false_path -to [get_ports {usb_uart_tx led[*] host_spi_probe[*] protocol_out[*] protocol_io[*] i2c_pullup[*]}]
